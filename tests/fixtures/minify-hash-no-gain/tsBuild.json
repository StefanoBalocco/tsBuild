[
	{
		"target": "lib",
		"tsConfig": "tsconfig.json",
		"prefix": "project",
		"minify": {
			"files": [ "assets/no-gain.js" ],
			"terser": true,
			"terserCompanion": false
		},
		"templatesHtml": [
			{
				"filename": "templates/token.html",
				"destination": "out",
				"variables": [
					{ "name": "token", "type": "hash-sha2-224", "value": [ "assets/no-gain.js", "assets" ] }
				]
			}
		]
	}
]