[
	{
		"target": "lib",
		"tsConfig": "tsconfig.json",
		"prefix": "project",
		"copy": [
			{
				"destination": "out/assets",
				"files": [ "assets/one.txt", "assets/two.txt" ]
			}
		],
		"templates": [
			{
				"filename": "templates/page.html",
				"destination": "out/pages",
				"variables": [
					{ "name": "title", "type": "string", "value": "tsBuild template" },
					{ "name": "stamp", "type": "mtime", "value": "assets/mtime.txt" }
				]
			}
		]
	}
]
