{
	"compilerOptions": {
		"rootDir": "./src-alpha",
		"outDir": "./shared",
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"declaration": false,
		"removeComments": true,
		"strict": true,
		"noImplicitAny": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true
	},
	"include": [ "src-alpha/index.ts" ]
}
