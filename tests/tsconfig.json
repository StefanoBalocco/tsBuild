{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"declaration": false,
		"removeComments": true,
		"sourceMap": false,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"strictFunctionTypes": true,
		"strictPropertyInitialization": true,
		"noImplicitThis": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"allowSyntheticDefaultImports": true,
		"types": [ "node" ]
	},
	"files": [ "src/tsBuild.test.ts" ]
}
